            }
        },
        "hash": {
            "url": "https://github.com/FaKL-Code/FaKL-Code-IDE/releases/download/v$version/SHA256SUMS.txt",
            "regex": "$sha256\\s+FaKL-Code-Windows-x64.exe"
        }
    }
