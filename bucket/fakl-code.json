    "notes": "O instalador do Windows não é assinado. Esta instalação é portátil: o auto-update da IDE só avisa; atualize com `scoop update fakl-code`.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/FaKL-Code/FaKL-Code-IDE/releases/download/v0.1.7/FaKL-Code-Windows-x64.exe",
            "hash": "e884e5342f16a351f6caab4e8826039e8a27f1f26326be9223a52ebf8aaa400e"
        }
    },
    "innosetup": true,
    "bin": [
        [
            "FaKL-Code.exe",
            "fakl-code"
        ]
    ],
    "shortcuts": [
        [
            "FaKL-Code.exe",
            "FaKL-Code IDE"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/FaKL-Code/FaKL-Code-IDE/releases",
        "jsonpath": "$[0].tag_name",
